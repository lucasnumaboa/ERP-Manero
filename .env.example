# Configurações do Banco de Dados
# Copie este arquivo para .env e preencha com seus valores
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui
DB_NAME=erp_maneiro
DB_PORT=3306

# Chave secreta para JWT - OBRIGATÓRIA (o backend não inicia sem ela; mínimo 32 caracteres)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# O backend lê backend/.env (ou este .env na raiz, se aquele não existir)
SECRET_KEY=sua_chave_secreta_aqui
