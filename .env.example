# Configurações do Banco de Dados
# Copie este arquivo para .env e preencha com seus valores
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui
DB_NAME=erp_maneiro
DB_PORT=3306

# Chave secreta para JWT (gere uma chave segura para produção)
# Exemplo: openssl rand -hex 32
SECRET_KEY=sua_chave_secreta_aqui
