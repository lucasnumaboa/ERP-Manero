# Docker Environment Configuration for ERP-MANEIRO
# Copy this file to .env before running docker-compose

# Database Configuration
DB_HOST=db
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_NAME=erp_maneiro
DB_PORT=3306

# MySQL Root Password
MYSQL_ROOT_PASSWORD=root_password_change_me

# API Configuration
SECRET_KEY=chave_secreta_mude_em_producao
API_PORT=8000

# Frontend Port
FRONTEND_PORT=3000

# External Database Port (for connecting from host)
DB_PORT_EXTERNAL=3306
